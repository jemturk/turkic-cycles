EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public client key -- either the publishable key (sb_publishable_..., preferred) or
# the legacy anon key. Both ship inside the app by design. Never the secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Cloudflare Turnstile site key. Leave unset to keep CAPTCHA off. Ship a
# build with it BEFORE enabling CAPTCHA in Supabase (see src/components/captcha/turnstile.ts).
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: RevenueCat public SDK keys (appl_... / goog_...) for Turkic Circles Plus.
# Leave unset and the Plus screen offers the waitlist instead of selling anything.
# The SECRET RevenueCat key never goes here -- it's a Supabase function secret
# (see supabase/functions/revenuecat-webhook/index.ts).
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Crash reporting (src/lib/sentry.ts): the project's DSN from Sentry > Project
# settings > Client Keys. Public by design. Unset = reporting off.
# EXPO_PUBLIC_SENTRY_DSN=
