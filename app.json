{
  "expo": {
    "name": "Turkic Circles",
    "slug": "turek",
    "scheme": "turek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon-ios.png",
      "bundleIdentifier": "com.turek.app"
    },
    "android": {
      "package": "com.turek.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FCEAD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "./plugins/withQuietLibraryWarnings",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FEF6EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Turkic Circles needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Turkic Circles needs access to your camera so you can take a profile picture."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#127A87"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Turkic Circles uses your location to show circle events near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45279546-0064-4468-9831-91daa4a2ef1b"
      }
    },
    "owner": "jemturk"
  }
}
