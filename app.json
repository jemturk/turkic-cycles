{
  "expo": {
    "name": "Turkic Circles",
    "slug": "turanci",
    "scheme": "turek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon-ios.png",
      "bundleIdentifier": "com.turek.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.turek.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FCEAD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "./plugins/withQuietLibraryWarnings",
      "./plugins/withShortNativeBuildPaths",
      "./plugins/withReleaseSigning",
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FEF6EC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Turkic Circles needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Turkic Circles needs access to your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#127A87"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Turkic Circles uses your location to show circle events near you."
        }
      ],
      "expo-web-browser",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "turek",
          "project": "turek",
          "experimental_android": {
            "enableAndroidGradlePlugin": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45279546-0064-4468-9831-91daa4a2ef1b"
      }
    },
    "owner": "jemturk"
  }
}
