# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code per-machine settings
.claude/settings.local.json

# Firebase service-account private keys (uploaded to EAS for push; never commit)
*firebase-adminsdk*.json

# Personal editor settings (e.g. written by VS Code extensions).
.vscode/settings.json
